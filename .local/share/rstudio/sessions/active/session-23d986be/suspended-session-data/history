v_j_trt = (r_j_trt * r_j_ctl * d_j * (r_j - d_j)) / (r_j^2 * (r_j - 1)),
d_j_ctl_exp = r_j_ctl * (d_j / r_j),
v_j_ctl = (r_j_trt * r_j_ctl * d_j * (r_j - d_j)) / (r_j^2 * (r_j - 1))
) |>
filter(d_j > 0)
sum(km_estimates$d_j_ctl)
sum(km_estimates$d_j_ctl_exp)
(sum(km_estimates$d_j_ctl) - sum(km_estimates$d_j_ctl_exp))^2 / sum(km_estimates$v_j_ctl, na.rm = TRUE)
